# Copie ce fichier en ".env" et remplis les valeurs. Ne commite JAMAIS le .env réel.

# --- Compte SIP du "bot" (à CRÉER séparément de ton compte iPhone) ---
# Le plus simple : un 2e compte gratuit sur sip.linphone.org (app Linphone > Assistant > Créer un compte).
# C'est CE compte qui va t'appeler / répondre à tes appels.
SIP_BOT_USERNAME=
SIP_BOT_PASSWORD=
SIP_BOT_DOMAIN=sip.linphone.org

# --- Adresse SIP à appeler en cas d'alerte : TON compte Linphone (celui notifié sur ton iPhone) ---
SIP_ALERT_TARGET=sip:ton_identifiant@sip.linphone.org

# --- TTS (Piper, local et gratuit) ---
# Voix FR dispo notamment : fr_FR-tom-medium (masculine, grave -> bon point de départ pour un effet "Jarvis"),
# fr_FR-siwis-medium (féminine), fr_FR-upmc-jessica.
PIPER_VOICE=fr_FR-tom-medium

# --- API HTTP (statut + mode test) ---
API_PORT=8085
API_KEY=change-moi-en-un-secret-fort

# --- Chemins internes (laisser par défaut en Docker) ---
DATA_DIR=/app/data
CONFIG_PATH=/app/config/services.yaml
