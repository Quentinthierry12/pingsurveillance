# Copie ce fichier en ".env" et remplis les valeurs. Ne commite JAMAIS le .env réel.

# --- PagerDuty ---
# Crée un compte PagerDuty (gratuit jusqu'à 5 utilisateurs), un Service avec
# une intégration "Events API v2", récupère la clé d'intégration ci-dessous.
# Configure aussi tes règles de notification (Profil > Notifications) pour
# être appelé par téléphone en priorité "high"/"critical".
PAGERDUTY_ROUTING_KEY=

# --- API HTTP (statut + mode test) ---
API_PORT=8085
API_KEY=change-moi-en-un-secret-fort

# --- Chemins internes (laisser par défaut en Docker) ---
DATA_DIR=/app/data
CONFIG_PATH=/app/config/services.example.yaml
